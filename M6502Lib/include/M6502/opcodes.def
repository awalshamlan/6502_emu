// Load / Store 
// LDA
OPCODE(LDA_IM,    0xA9)
OPCODE(LDA_ZP,    0xA5)
OPCODE(LDA_ZPX,   0xB5)
OPCODE(LDA_ABS,   0xAD)
OPCODE(LDA_ABSX,  0xBD)
OPCODE(LDA_ABSY,  0xB9)
OPCODE(LDA_INDX,  0xA1)
OPCODE(LDA_INDY,  0xB1)
// LDX
OPCODE(LDX_IM,    0xA2)
OPCODE(LDX_ZP,    0xA6)
OPCODE(LDX_ZPY,   0xB2)
OPCODE(LDX_ABS,   0xAE)
OPCODE(LDX_ABSY,  0xAE)
// LDY
OPCODE(LDY_IM,    0xA0)
OPCODE(LDY_ZP,    0xA4)
OPCODE(LDY_ZPX,   0xB4)
OPCODE(LDY_ABS,   0xAC)
OPCODE(LDY_ABSX,  0xBC)
// STA
OPCODE(STA_ZP,    0x85)
OPCODE(STA_ZPX,   0x95)
OPCODE(STA_ABS,   0x8D)
OPCODE(STA_ABSX,  0x9D)
OPCODE(STA_ABSY,  0x99)
OPCODE(STA_INDX,  0x81)
OPCODE(STA_INDY,  0x91)
// STX
OPCODE(STX_ZP,  0x86)
OPCODE(STX_ZPY, 0x96)
OPCODE(STX_ABS, 0x8E)
// STY
OPCODE(STY_ZP,  0x84)
OPCODE(STY_ZPX, 0x94)
OPCODE(STY_ABS, 0x8C)

// Transfers
OPCODE(TAX, 0xAA)
OPCODE(TAY, 0xA8)
OPCODE(TSX, 0xBA)
OPCODE(TXA, 0x8A)
OPCODE(TXS, 0x9A)
OPCODE(TYA, 0x98)

// Stack Ops
// PHA
OPCODE(PHA, 0x48)
// PHP
OPCODE(PHP, 0x08)
// PLA
OPCODE(PLA, 0x68)
// PLP
OPCODE(PLP, 0x28)

// Logical
// AND
OPCODE(AND_IM,    0x29)
OPCODE(AND_ZP,    0x25)
OPCODE(AND_ZPX,   0x35)
OPCODE(AND_ABS,   0x2D)
OPCODE(AND_ABSX,  0x3D)
OPCODE(AND_ABSY,  0x39)
OPCODE(AND_INDX,  0x21)
OPCODE(AND_INDY,  0x31)
// EOR
OPCODE(EOR_IM,    0x49)
OPCODE(EOR_ZP,    0x45)
OPCODE(EOR_ZPX,   0x55)
OPCODE(EOR_ABS,   0x4D)
OPCODE(EOR_ABSX,  0x5D)
OPCODE(EOR_ABSY,  0x59)
OPCODE(EOR_INDX,  0x41)
OPCODE(EOR_INDY,  0x51)
// ORA (jojo reference)
OPCODE(ORA_IM,    0x09)
OPCODE(ORA_ZP,    0x05)
OPCODE(ORA_ZPX,   0x15)
OPCODE(ORA_ABS,   0x0D)
OPCODE(ORA_ABSX,  0x1D)
OPCODE(ORA_ABSY,  0x19)
OPCODE(ORA_INDX,  0x01)
OPCODE(ORA_INDY,  0x11)
// BIT
OPCODE(BIT_ZP,  0x24)
OPCODE(BIT_ABS, 0x2C)

// Arithmetic
// ADC
OPCODE(ADC_IM,    0x69)
OPCODE(ADC_ZP,    0x65)
OPCODE(ADC_ZPX,   0x75)
OPCODE(ADC_ABS,   0x6D)
OPCODE(ADC_ABSX,  0x7D)
OPCODE(ADC_ABSY,  0x79)
OPCODE(ADC_INDX,  0x61)
OPCODE(ADC_INDY,  0x71)
//SBC
OPCODE(SBC_IM,      0xE9)
OPCODE(SBC_ZP,      0xE5)
OPCODE(SBC_ZPX,     0xF5)
OPCODE(SBC_ABS,     0xED)
OPCODE(SBC_ABSX,    0xFD)
OPCODE(SBC_ABSY,    0xF9)
OPCODE(SBC_INDX,    0xE1)
OPCODE(SBC_INDY,    0xF1)

// CPM
OPCODE(CMP_IM,    0xC9)
OPCODE(CMP_ZP,    0xC5)
OPCODE(CMP_ZPX,   0xD9)
OPCODE(CMP_ABS,   0xCD)
OPCODE(CMP_ABSX,  0xDD)
OPCODE(CMP_ABSY,  0xDD)
OPCODE(CMP_INDX,  0xC1)
OPCODE(CMP_INDY,  0xD1)
// CPX
OPCODE(CPX_IM,  0xE0)
OPCODE(CPX_ZP,  0xE4)
OPCODE(CPX_ABS, 0xEC)
// CPY
OPCODE(CPY_IM,  0xC0)
OPCODE(CPY_ZP,  0xC4)
OPCODE(CPY_ABS, 0xCC)

// Increment / Decrement
// INC
OPCODE(INC_ZP,    0xE6)
OPCODE(INC_ZPX,   0xF6)
OPCODE(INC_ABS,   0xEE)
OPCODE(INC_ABSX,  0xFE)
// INX
OPCODE(INX, 0xE8)
// INY
OPCODE(INY, 0xC8)
// DEC
OPCODE(DEC_ZP,    0xC6)
OPCODE(DEC_ZPX,   0xD6)
OPCODE(DEC_ABS,   0xCE)
OPCODE(DEC_ABSX,  0xDE)
// DEX
OPCODE(DEX, 0xCA)
// DEY
OPCODE(DEY, 0x88)

// Shifts
// ASL
OPCODE(ASL_AC,    0x0A)
OPCODE(ASL_ZP,    0x06)
OPCODE(ASL_ZPX,   0x16)
OPCODE(ASL_ABS,   0x0E)
OPCODE(ASL_ABSX,  0x1E)
// LSR
OPCODE(LSR_AC,    0x4A)
OPCODE(LSR_ZP,    0x46)
OPCODE(LSR_ZPX,   0x56)
OPCODE(LSR_ABS,   0x4E)
OPCODE(LSR_ABSX,  0x5E)

// Branch
OPCODE(BCC, 0x90)
OPCODE(BCS, 0xB0)
OPCODE(BVC, 0x50)
OPCODE(BVS, 0x70)
OPCODE(BEQ, 0xF0)
OPCODE(BNE, 0xD0)
OPCODE(BMI, 0x30)
OPCODE(BPL, 0x10)



// INTERRUPT
OPCODE(BRK, 0x00)

// STATUS
OPCODE(CLC, 0x18)
OPCODE(CLD, 0xD8)
OPCODE(CLI, 0x58)
OPCODE(CLV, 0xB8)






// JMP
OPCODE(JMP_ABS, 0x4C)
OPCODE(JMP_IND, 0x6C)

// JSR
OPCODE(JSR_ABS, 0x20)




// NOP
OPCODE(NOP, 0xEA)










