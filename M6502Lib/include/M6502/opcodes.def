// JMP
OPCODE(JMP_ABS, 0x4C)
OPCODE(JMP_IND, 0x6C)

// JSR
OPCODE(JSR_ABS, 0x20)

// LDA
OPCODE(LDA_IM,    0xA9)
OPCODE(LDA_ZP,    0xA5)
OPCODE(LDA_ZPX,   0xB5)
