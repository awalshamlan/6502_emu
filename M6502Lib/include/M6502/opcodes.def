// ADC
OPCODE(ADC_IM,    0x69)
OPCODE(ADC_ZP,    0x65)
OPCODE(ADC_ZPX,   0x75)
OPCODE(ADC_ABS,   0x6D)
OPCODE(ADC_ABSX,  0x7D)
OPCODE(ADC_ABSY,  0x79)
OPCODE(ADC_INDX,  0x61)
OPCODE(ADC_INDY,  0x71)

// AND
OPCODE(AND_IM,    0x29)
OPCODE(AND_ZP,    0x25)
OPCODE(AND_ZPX,   0x35)
OPCODE(AND_ABS,   0x2D)
OPCODE(AND_ABSX,  0x3D)
OPCODE(AND_ABSY,  0x39)
OPCODE(AND_INDX,  0x21)
OPCODE(AND_INDY,  0x31)

// Branch
OPCODE(BCC, 0x90)
OPCODE(BCS, 0xB0)
OPCODE(BVC, 0x50)
OPCODE(BVS, 0x70)
OPCODE(BEQ, 0xF0)
OPCODE(BNE, 0xD0)
OPCODE(BMI, 0x30)
OPCODE(BPL, 0x10)



// BIT
OPCODE(BIT_ZP,  0x24)
OPCODE(BIT_ABS, 0x2C)

// INTERRUPT
OPCODE(BRK, 0x00)

// STATUS
OPCODE(CLC, 0x18)
OPCODE(CLD, 0xD8)
OPCODE(CLI, 0x58)
OPCODE(CLV, 0xB8)


// COMPARE
// A Register
OPCODE(CMP_IM,    0xC9)
OPCODE(CMP_ZP,    0xC5)
OPCODE(CMP_ZPX,   0xD9)
OPCODE(CMP_ABS,   0xCD)
OPCODE(CMP_ABSX,  0xDD)
OPCODE(CMP_ABSY,  0xDD)
OPCODE(CMP_INDX,  0xC1)
OPCODE(CMP_INDY,  0xD1)

// X Register
OPCODE(CPX_IM,  0xE0)
OPCODE(CPX_ZP,  0xE4)
OPCODE(CPX_ABS, 0xEC)

// Y Register
OPCODE(CPY_IM,  0xC0)
OPCODE(CPY_ZP,  0xC4)
OPCODE(CPY_ABS, 0xCC)

